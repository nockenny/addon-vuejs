{
    "name": "pupop - setting",
    "version": "0.1",
    "description": "pupop demo with custom tabs, indexDB, and reminders",
    "manifest_version": 3,
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "js/libs/jquery-3.7.1.min.js"
            ]
        }
    ],
    "action": {
        "default_popup": "html/default_popup.html"
    },
    "icons": {
        "16": "images/icon.png",
        "48": "images/icon.png",
        "128": "images/icon.png"
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "activeTab",
        "scripting",
        "alarms",
        "notifications"
    ],
    "background": {
        "service_worker": "js/background.js"
    }
}
